PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:3000

JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=1d

MONGODB_URI=mongodb://localhost:27017/hypermarket

# Rate limiting global (API general)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Usuario de backup con rol backup/restore (NUNCA usado por Express)
# MONGODB_BACKUP_URI=mongodb://localhost:27017/hypermarket
BACKUP_DIR=backups

# ==== Object Storage (imágenes) ====
# Proveedor de almacenamiento: local (desarrollo/test) o s3 (Cloudflare R2 en producción)
STORAGE_PROVIDER=local
# Directorio usado por el proveedor local (se sirve por HTTP en /uploads)
# STORAGE_LOCAL_DIR=./storage
# Base URL pública del servidor (para construir URLs del proveedor local)
STORAGE_PUBLIC_BASE_URL=http://localhost:3000

# Límites de subida
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_PRESIGN_EXPIRES_SECONDS=600

# Configuración Cloudflare R2 (obligatoria si STORAGE_PROVIDER=s3)
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET=your_bucket_name
# R2_PUBLIC_URL=https://cdn.hipermercadosuperior.com